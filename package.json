{
  "name": "zharf",
  "version": "0.1.0",
  "description": "JavaScript and TypeScript library for the Zharf API platform (platform.zharf.ai)",
  "keywords": [
    "zharf",
    "ai",
    "llm",
    "chat",
    "embeddings",
    "openai-compatible",
    "persian",
    "farsi"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./browser": {
      "import": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "require": {
        "types": "./dist/browser.d.cts",
        "default": "./dist/browser.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "homepage": "https://platform.zharf.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZharfAI/zharf-js.git"
  },
  "bugs": {
    "url": "https://github.com/ZharfAI/zharf-js/issues"
  },
  "author": "ZharfAI",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "18.19.68",
    "tsup": "8.3.5",
    "typescript": "5.7.3",
    "vitest": "2.1.9"
  }
}
